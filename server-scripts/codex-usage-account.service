# Сервис «Аккаунт» дашборда расхода — страница смены собственного пароля.
# Файл: /etc/systemd/system/codex-usage-account.service
#
# Слушает только 127.0.0.1 — наружу его публикует Caddy, который добавляет
# заголовки X-User (из basic_auth) и X-Auth-Token (общий секрет).
# Сам пароль меняет не сервис, а codex-usage-passwd под sudo — см.
# sudoers-codex-usage-account.
[Unit]
Description=CloudCodexServer usage dashboard - account service
After=network.target

[Service]
Type=simple
User=codexacct
Group=codexacct
EnvironmentFile=/etc/codex-usage-account.env
ExecStart=/usr/bin/python3 /usr/local/sbin/codex-usage-account.py
Restart=on-failure
RestartSec=5

# Песочница. ВАЖНО: namespace наследуется потомками, включая запущенный через
# sudo codex-usage-passwd — поэтому в ReadWritePaths должно быть всё, что нужно
# ЕМУ, а не только самому сервису:
#   /etc/caddy    — правит Caddyfile (иначе EROFS и смена пароля падает)
#   /root         — пишет codex-usage-credentials.txt
#   /run/systemd  — `systemctl reload caddy` ходит в /run/systemd/private
# /home нужен только на чтение (codex-usage-report.py читает ~/.codex/sessions
# всех пользователей) — поэтому ReadOnlyPaths=/home, а не ProtectHome.
#
# Почему не ProtectHome=read-only, что выглядело бы аккуратнее: измерено на
# systemd 255 — ReadWritePaths вырезает каталог из-под ProtectSystem=strict
# (/etc/caddy пишется), но НЕ из-под ProtectHome=read-only: запись в /root
# падает с EROFS. Документация читается иначе, поведение — такое; при смене
# версии systemd стоит перепроверить, прежде чем «ужесточать» обратно.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadOnlyPaths=/home
ReadWritePaths=/var/lib/codex-usage /etc/caddy /root /run/systemd

[Install]
WantedBy=multi-user.target
